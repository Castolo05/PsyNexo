# ============================================================
# NexoMente - Variables de Entorno del Servidor
# ============================================================
# IMPORTANTE: Nunca subas este archivo a Git.
# Copia este archivo como .env y rellena con tus valores reales.
# ============================================================

# Puerto del servidor (por defecto 3001)
PORT=3001

# URL de tu base de datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
# Ejemplo local: postgresql://postgres:misuperpassword@localhost:5432/nexomente_db
DATABASE_URL="postgresql://usuario:password@localhost:5432/nexomente_db"

# URL del cliente frontend (React/Vite)
CLIENT_URL="http://localhost:5173"

# Secret para firmar los JWT. Usa una cadena larga y aleatoria en producción.
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CAMBIA_ESTO_POR_UN_SECRET_MUY_LARGO_Y_ALEATORIO"

# Duración del token JWT (ej: "7d" = 7 días, "24h" = 24 horas)
JWT_EXPIRES_IN="7d"

# Entorno
NODE_ENV="development"
